{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "Database": {
    "ApplyMigrationsAtStartup": true,
    "SeedDevelopmentDataAtStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "//": "Development only. Production supplies Jwt__SigningKey as a secret env var; it is never committed.",
    "SigningKey": "vetflow-development-signing-key-not-for-production-use"
  }
}
