{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Database": {
    "ApplyMigrationsAtStartup": false
  },
  "Clinic": {
    "TimeZone": "Africa/Cairo"
  },
  "Jwt": {
    "Issuer": "vetflow",
    "Audience": "vetflow",
    "LifetimeHours": 12
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
